{
  "name": "@pochimail/desktop",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*"
  },
  "exports": {
    "./shared/i18n/screen-copy": "./src/shared/i18n/screen-copy.ts",
    "./shared/ipc/device-name": "./src/shared/ipc/device-name.ts",
    "./shared/platform": "./src/shared/platform.ts"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node --env-file-if-exists=../../.env node_modules/electron-vite/bin/electron-vite.js dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc",
    "lint": "biome check .",
    "knip": "knip",
    "test": "vitest run",
    "e2e": "node e2e/build.ts && playwright test --config e2e/playwright.config.ts",
    "package": "electron-vite build && electron-builder --config electron-builder.config.ts --publish never",
    "package:smoke": "node packaging/smoke.ts",
    "package:install": "node packaging/install-check.ts",
    "package:size": "node packaging/report-size.ts",
    "package:signing": "node packaging/report-signing.ts",
    "package:verify": "node packaging/verify-release.ts",
    "package:finalize": "node packaging/finalize-release.ts"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.65.1",
    "@pochimail/accounts": "workspace:*",
    "@pochimail/actions": "workspace:*",
    "@pochimail/ai": "workspace:*",
    "@pochimail/classification": "workspace:*",
    "@pochimail/cleanup": "workspace:*",
    "@pochimail/db": "workspace:*",
    "@pochimail/gmail": "workspace:*",
    "@pochimail/kernel": "workspace:*",
    "@pochimail/logger": "workspace:*",
    "@pochimail/net": "workspace:*",
    "@pochimail/pipeline": "workspace:*",
    "@pochimail/testing": "workspace:*",
    "@pochimail/typescript-config": "workspace:*",
    "@pochimail/ui": "workspace:*",
    "@pochimail/workflows": "workspace:*",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.170.46",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.1",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "better-sqlite3-multiple-ciphers": "13.1.1",
    "node-llama-cpp": "3.22.3",
    "onnxruntime-node": "1.30.0"
  },
  "main": "./out/main/index.js"
}
