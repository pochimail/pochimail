{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/pnpm-lock.yaml",
      "!**/*.md",
      "!docs",
      "!packages/ui/src/styles/tokens.json"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": false
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "noNestedTernary": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noUselessFragments": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/styles/theme.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/accounts/**",
        "packages/mailbox/**",
        "packages/classification/**",
        "packages/cleanup/**",
        "packages/actions/**",
        "packages/documents/**",
        "packages/workflows/**",
        "!**/testing/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "Domain and workflow code is pure TypeScript: no Electron (AGENTS.md rule 10)."
                },
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "Domain and workflow code is pure TypeScript: no node:* (AGENTS.md rule 10)."
                  },
                  {
                    "group": ["electron/*"],
                    "message": "Domain and workflow code is pure TypeScript: no Electron (AGENTS.md rule 10)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.stories.tsx",
        "**/*.config.ts",
        "**/*.config.cjs",
        "**/.storybook/**",
        "**/*.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tooling/**",
        "apps/cli/**",
        "**/packaging/**",
        "**/bench/**",
        "packages/testing/src/eval/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "packages/testing/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/cli/src/scenario.ts",
        "apps/desktop/packaging/gallery-check.ts",
        "apps/desktop/src/main/secret-vault.ts",
        "apps/desktop/src/model-host/serve.ts",
        "apps/desktop/src/shared/ipc/client.ts",
        "apps/desktop/src/shared/ipc/secrets.ts",
        "apps/desktop/src/shared/ipc/server.ts",
        "packages/ai/bench/llm.ts",
        "packages/pipeline/src/outbox-relay.ts",
        "packages/pipeline/src/job-runner.ts",
        "packages/logger/src/redaction.ts",
        "packages/actions/src/use-cases/apply-action.ts",
        "packages/cleanup/src/use-cases/build-digest.ts",
        "packages/classification/src/use-cases/classify-batch.ts",
        "packages/accounts/src/use-cases/connect-account.ts",
        "packages/workflows/src/use-cases/run-incremental-sync.ts",
        "packages/workflows/src/use-cases/scan-runner.ts",
        "packages/cleanup/src/use-cases/summarize-mailbox.ts",
        "packages/actions/src/use-cases/undo-action.ts",
        "packages/db/src/actions/action-log-repository.ts",
        "packages/db/src/classification/signal-repository.ts",
        "packages/db/src/mailbox/message-repository.ts",
        "packages/db/src/sqlite-job-queue.ts",
        "packages/db/src/sqlite-unit-of-work.ts",
        "packages/net/src/egress/http-client.ts",
        "packages/net/src/egress/rate-limit.ts",
        "packages/net/src/oauth/loopback.ts",
        "packages/net/src/oauth/tokens.ts",
        "packages/ui/src/i18n/format.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "warn"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/shared/ipc/secrets.ts",
        "packages/workflows/src/use-cases/run-incremental-sync.ts",
        "packages/workflows/src/use-cases/scan-runner.ts",
        "packages/db/src/actions/action-log-repository.ts",
        "packages/db/src/classification/signal-repository.ts",
        "packages/testing/src/fixture-mailbox/generator.ts",
        "packages/testing/src/fixture-mailbox/mbox.ts",
        "packages/testing/src/in-memory-store.ts",
        "packages/testing/src/workspace-rules.test.ts",
        "packages/ui/src/components/sidebar.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "warn"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/renderer/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@pochimail/ui/i18n/format.ts": {
                    "importNames": ["t", "getLocale"],
                    "message": "Renderer code reads the language through useT() and useLocale() (I18nProvider); the global t() is for non-React code."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/renderer/**/*.test.ts",
        "apps/desktop/src/renderer/**/*.test.tsx",
        "apps/desktop/src/renderer/**/*.stories.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
