  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Newsreader",
          "Georgia",
          "serif"
        ]
      },
      "ui": {
        "$type": "fontFamily",
        "$value": [
          "Instrument Sans",
          "system-ui",
          "-apple-system",
          "Hiragino Sans",
          "Noto Sans JP",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "display": {
        "$type": "fontWeight",
        "$value": 450
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 450,
        "fontSize": "40px",
        "lineHeight": 1.1,
        "letterSpacing": "-0.02em"
      },
      "$description": "Welcome, letter titles"
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 450,
        "fontSize": "32px",
        "lineHeight": 1.15,
        "letterSpacing": "-0.02em"
      },
      "$description": "Screen titles (h1)"
    },
    "figure": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 450,
        "fontSize": "34px",
        "lineHeight": 1,
        "letterSpacing": "-0.02em"
      },
      "$description": "Large numbers"
    },
    "section": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontWeight": 600,
        "fontSize": "17px",
        "lineHeight": 1.3,
        "letterSpacing": "-0.005em"
      },
      "$description": "Section titles (h2)"
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontWeight": 400,
        "fontSize": "15px",
        "lineHeight": 1.5,
        "letterSpacing": "0"
      }
    },
    "ui": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontWeight": 500,
        "fontSize": "14px",
        "lineHeight": 1.4,
        "letterSpacing": "0"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontWeight": 400,
        "fontSize": "13px",
        "lineHeight": 1.45,
        "letterSpacing": "0"
      }
    },
    "overline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontWeight": 600,
        "fontSize": "12px",
        "lineHeight": 1.3,
        "letterSpacing": "0.06em"
      },
      "$description": "Sidebar group labels, uppercase"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "control": {
      "$type": "dimension",
      "$value": "10px"
