  "motion": {
    "duration": {
      "press": {
        "$type": "duration",
        "$value": "150ms"
      },
      "panel": {
        "$type": "duration",
        "$value": "220ms"
      },
      "count": {
        "$type": "duration",
        "$value": "600ms"
      }
    },
    "easing": {
      "out": {
        "$type": "cubicBezier",
        "$value": [
          0.22,
          1,
          0.36,
          1
        ]
      }
    }
  }
}
