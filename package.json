{
  "name": "pochimail",
  "private": true,
  "version": "0.0.0",
  "description": "Pochimail monorepo root. Not a package: orchestration scripts only.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pochimail/pochimail.git"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=12.21.0 <13"
  },
  "scripts": {
    "check": "turbo run typecheck lint test && pnpm knip && pnpm lint:root && pnpm manypkg && pnpm arch && pnpm quality",
    "arch": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json apps packages",
    "quality": "node tooling/ci/src/check-quality.ts",
    "gates": "node tooling/ci/src/assert-gates.ts",
    "mascot:rim": "node tooling/ci/src/make-mascot-rim.ts",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "biome check biome.json package.json turbo.json",
    "format": "biome format --write .",
    "manypkg": "manypkg check",
    "test": "turbo run test",
    "build": "turbo run build",
    "knip": "turbo run knip --concurrency=1",
    "eval": "turbo run eval"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@manypkg/cli": "0.25.1",
    "@swc/core": "1.16.22",
    "dependency-cruiser": "18.7.2",
    "knip": "6.45.1",
    "turbo": "2.11.11"
  }
}
